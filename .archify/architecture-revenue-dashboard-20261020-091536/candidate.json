  "cards": [
    {
      "dot": "cyan",
      "title": "Why the session cookie works across ports",
      "items": [
        "Cookies ignore the port, so the cookie set on localhost:4000 is also visible on localhost:3000.",
        "That lets the Next.js server forward the browser cookie instead of keeping a second copy of the session.",
        "The solid arrows render the dashboard; the dashed arrow is the browser calling the API directly from the Next.js bundle, which needs the CORS origin to match."
      ]
    },
    {
      "dot": "emerald",
      "title": "Server-side sessions",
      "items": [
        "Login stores only a SHA-256 hash of the token; the raw token lives in an httpOnly cookie.",
        "Logout deletes the row, so revocation is immediate. Expired rows are removed when touched.",
        "Admin routes enforce the cookie in the API, independent of the UI."
      ]
    },
    {
      "dot": "rose",
      "title": "Two controls on sign-in",
      "items": [
        "One error for a wrong email and a wrong password alike, so the form does not reveal which accounts exist.",
        "Repeated failures from one client return 429 with Retry-After; a successful sign-in clears the counter.",
        "The counter is per process, so a restart clears it and it does not span several API instances."
      ]
    },
    {
      "dot": "amber",
      "title": "Local topology",
      "items": [
        "Three processes on one machine; Compose runs only the database.",
        "The API allows one CORS origin, which is the UI origin, so both must agree.",
        "Prisma connects through the pg driver adapter and reads its URL from config, not the schema."
      ]
    }
  ]
